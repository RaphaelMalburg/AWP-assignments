@{
    ViewData["Title"] = "Delete Page";
    Layout = "_LayoutAdmin";
}

@model aspCms.Models.Content

<h2>Delete Page</h2>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this page?</h3>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Page</dt>
        <dd class="col-sm-10">@Model.Page</dd>
        
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Html.Raw(Model.Title)</dd>
        
        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@Model.Author</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="List" class="btn btn-secondary">Cancel</a>
</form>